# Razer BlackShark V3 Pro (PC and Xbox) — grant access to the HID interface without root.
# The daemon (blacksharkd) opens /dev/hidraw* directly via hidapi.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0577|0a55", TAG+="uaccess", MODE="0660", GROUP="users"

